# ──────────────────────────────────────────────────────────────────────────────
# miniERP — Umgebungsvariablen
# Kopieren: cp .env.example .env  →  Werte anpassen
# Geheimschlüssel generieren: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

# ── miniERP Datenbank ─────────────────────────────────────────────────────────
POSTGRES_DB=minierp
POSTGRES_USER=minierp
POSTGRES_PASSWORD=change_me_in_production

# ── miniERP Backend ───────────────────────────────────────────────────────────
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
FIRST_SUPERUSER_EMAIL=admin@localhost
FIRST_SUPERUSER_PASSWORD=change_me_in_production

# ── Mandanten / Geschäftsbereiche (TODO: noch nicht implementiert) ────────────
# Derzeit werden die Mandanten beim ersten Start als Seed-Daten angelegt.
# Geplant: Konfiguration vollständig über .env, damit das System ohne
# Code-Änderungen für andere Betriebe nutzbar ist.
#
# TENANT1_CODE=bau
# TENANT1_NAME=Muster Bauunternehmen
# TENANT1_ADDRESS=Musterstraße 1\n12345 Musterstadt
# TENANT1_IBAN=DE89370400440532013000
# TENANT1_INVOICE_PREFIX=R
# TENANT1_QUOTE_PREFIX=A
#
# TENANT2_CODE=huf
# TENANT2_NAME=Muster Hufpflege
# TENANT2_ADDRESS=Musterstraße 1\n12345 Musterstadt
# TENANT2_IBAN=DE89370400440532013000
# TENANT2_INVOICE_PREFIX=HUF
# TENANT2_QUOTE_PREFIX=AHUF
#
# Für Einzelbetrieb (nur eine Sparte):
# TENANT2_CODE=   ← leer lassen → kein zweiter Mandant wird angelegt

# ── Ports (nach außen) ────────────────────────────────────────────────────────
FRONTEND_PORT=3000
PAPERLESS_PORT=8001
N8N_PORT=5678
DEV_PORT=5173

# ── Timezone ──────────────────────────────────────────────────────────────────
TZ=Europe/Berlin

# ── Paperless-ngx ────────────────────────────────────────────────────────────
# Eigene Datenbank — unabhängig von der miniERP-DB
PAPERLESS_DBPASS=change_me_paperless_db_password
PAPERLESS_SECRET_KEY=change_me_generate_with_openssl_rand_hex_32
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=change_me_in_production
PAPERLESS_ADMIN_MAIL=admin@example.com
# Öffentliche URL (VPS: https://paperless.meine-domain.de | Lokal: http://localhost:8001)
PAPERLESS_PUBLIC_URL=http://localhost:8001
# API-Token: nach erstem Login in Paperless erstellen (Profil → API-Token → erzeugen)
PAPERLESS_TOKEN=

# ── Interne Service-URLs (normalerweise nicht ändern) ─────────────────────────
PAPERLESS_URL=http://paperless:8000
GOTENBERG_URL=http://gotenberg:3000
OLLAMA_URL=http://ollama:11434

# ── Ollama Modell-Empfehlung ──────────────────────────────────────────────────
# Nach erstem Start: docker exec -it minierp-ollama-1 ollama pull llama3.2:3b
#
# Modellwahl nach verfügbarem RAM:
#   llama3.2:3b  →  ~2 GB RAM  — empfohlen (gutes Deutsch, effizient)
#   gemma3:4b    →  ~3 GB RAM  — gute Alternative
#   mistral:7b   →  ~5 GB RAM  — besser für lange Texte (≥8 GB RAM)
#   phi3:mini    →  ~2 GB RAM  — sehr schnell, schwächeres Deutsch

# ── n8n Workflow-Automation (Profile: automation) ─────────────────────────────
N8N_USER=admin
N8N_PASSWORD=change_me
N8N_DB=n8n
N8N_WEBHOOK_URL=http://localhost:5678

# ── Zukünftig: E-Mail (SMTP/POP3) ────────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASSWORD=change_me
# SMTP_FROM=miniERP <noreply@example.com>
# SMTP_TLS=true
#
# POP3_HOST=pop3.example.com
# POP3_PORT=995
# POP3_USER=eingang@example.com
# POP3_PASSWORD=change_me
# POP3_SSL=true
